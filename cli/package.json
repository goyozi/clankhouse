{
    "name": "@clankhouse/cli",
    "version": "0.0.2",
    "description": "Command-line client for ClankHouse servers",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./src/index.ts"
    },
    "bin": {
        "clank": "./bin/clank.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goyozi/clankhouse.git",
        "directory": "cli"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            }
        },
        "bin": {
            "clank": "./dist/bin.js"
        }
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "pnpm build",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.12.1",
        "@clankhouse/protocol": "workspace:*",
        "@connectrpc/connect": "^2.1.2",
        "@connectrpc/connect-node": "^2.1.2",
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@clankhouse/core": "workspace:*",
        "@clankhouse/server": "workspace:*",
        "@clankhouse/test-utils": "workspace:*",
        "tsx": "^4.23.0",
        "zod": "catalog:"
    }
}
