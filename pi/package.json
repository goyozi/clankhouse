{
    "name": "@clankhouse/pi",
    "version": "0.2.0",
    "description": "Pi coding-agent adapter for ClankHouse",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./src/index.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goyozi/clankhouse.git",
        "directory": "pi"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            }
        }
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "pnpm build",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "@clankhouse/core": "workspace:*",
        "@clankhouse/test-utils": "workspace:*",
        "@clankhouse/testing": "workspace:*",
        "@earendil-works/pi-coding-agent": "^1.0.2"
    },
    "peerDependencies": {
        "@clankhouse/core": "workspace:^",
        "@earendil-works/pi-coding-agent": ">=0.84.1 <2"
    }
}
