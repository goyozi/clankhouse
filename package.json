{
    "name": "clankhouse",
    "version": "1.0.0",
    "private": true,
    "description": "Local-first durable AI workflows",
    "type": "module",
    "scripts": {
        "changeset": "changeset",
        "build": "pnpm -r --if-present build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "pnpm -r --if-present typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "version-packages": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "packageManager": "pnpm@11.9.0",
    "devDependencies": {
        "@changesets/cli": "^3.0.1",
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.4",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.9"
    }
}
