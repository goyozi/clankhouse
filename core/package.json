{
    "name": "@clankhouse/core",
    "version": "0.0.3",
    "description": "Durable local-first workflow runtime for ClankHouse",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./git": "./src/git/index.ts",
        "./*": "./src/*.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goyozi/clankhouse.git",
        "directory": "core"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./git": {
                "types": "./dist/git/index.d.ts",
                "import": "./dist/git/index.js"
            },
            "./*": {
                "types": "./dist/*.d.ts",
                "import": "./dist/*.js"
            }
        }
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "pnpm build",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "better-sqlite3": "^12.11.1",
        "handlebars": "^4.7.9",
        "nanoid": "^5.1.16",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@clankhouse/test-utils": "workspace:*",
        "fast-check": "^4.9.0"
    }
}
