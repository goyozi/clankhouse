{
    "name": "@clankhouse/codex",
    "version": "0.1.0",
    "description": "Codex coding-agent adapter for ClankHouse",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./src/index.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/goyozi/clankhouse.git",
        "directory": "codex"
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            }
        }
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "pnpm build",
        "test": "vitest run --config vitest.config.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "zod": "catalog:"
    },
    "devDependencies": {
        "@clankhouse/core": "workspace:*",
        "@clankhouse/test-utils": "workspace:*",
        "@openai/codex-sdk": "^0.160.0"
    },
    "peerDependencies": {
        "@clankhouse/core": "workspace:^",
        "@openai/codex-sdk": ">=0.157.1 <1"
    }
}
